<!--
  Template for the GitHub Pages version index, rendered by the docs
  deploy workflow (see the main branch). Placeholders:
    {{LATEST_VERSION}} - version string of the "latest" symlink/folder
    {{VERSION_LIST}}    - newline-separated <li><a href="VERSION/">VERSION</a></li>
-->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>phpEZ documentation</title>
<style>
  :root {
    color-scheme: light dark;
    --accent: #4f6df5;
    --bg: #ffffff;
    --fg: #1c1e21;
    --muted: #6b7280;
    --border: #e5e7eb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161a;
      --fg: #e6e7ea;
      --muted: #9ca3af;
      --border: #2a2d33;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 3rem 1.5rem;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    justify-content: center;
  }
  main {
    width: 100%;
    max-width: 640px;
  }
  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }
  p.subtitle {
    color: var(--muted);
    margin-top: 0;
    margin-bottom: 2rem;
  }
  .latest {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    margin-bottom: 2rem;
  }
  .latest a {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .latest span.badge {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    font-weight: 700;
  }
  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  ul.versions {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  ul.versions li {
    border-bottom: 1px solid var(--border);
  }
  ul.versions li:last-child {
    border-bottom: none;
  }
  ul.versions a {
    display: block;
    padding: 0.75rem 1.25rem;
  }
  ul.versions a:hover {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
</head>
<body>
<main>
  <h1>phpEZ documentation</h1>
  <p class="subtitle">API documentation generated by phpDocumentor.</p>

  <div class="latest">
    <a href="latest/">Latest documentation</a>
    <span class="badge">{{LATEST_VERSION}}</span>
  </div>

  <h2>All versions</h2>
  <ul class="versions">
{{VERSION_LIST}}
  </ul>
</main>
</body>
</html>
